{
  "name": "e-financials-woocommerce-integration",
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@woocommerce/e2e-utils-playwright": "^0.5.0",
    "@wordpress/env": "^10.28.0"
  },
  "scripts": {
    "wp-env": "wp-env",
    "start": "wp-env start",
    "stop": "wp-env stop",
    "destroy": "wp-env destroy",
    "import:demo": "wp-env run cli wp import wp-content/plugins/woocommerce/sample-data/sample_products.xml --authors=create",
    "test:e2e": "playwright test --config=tests/e2e/playwright.config.js --grep-invert @live",
    "test:e2e:headed": "playwright test --config=tests/e2e/playwright.config.js --headed --grep-invert @live",
    "test:e2e:ui": "playwright test --config=tests/e2e/playwright.config.js --ui",
    "test:e2e:live": "playwright test --config=tests/e2e/playwright.config.js --grep @live",
    "test:e2e:install": "playwright install --with-deps chromium"
  }
}
